# Comic Vault — build-time environment variables
#
# 1. Copy this file to dart_defines.env  (it is gitignored)
# 2. Fill in your Comic Vine API key from:
#    https://comicvine.gamespot.com/api/
# 3. Run / build with:
#    flutter run  --dart-define-from-file=dart_defines.env
#    flutter build apk --dart-define-from-file=dart_defines.env
#
# Alternatively, enter your key directly in the app under Settings → API.
# The in-app key takes precedence over the build-time key.

COMIC_VINE_API_KEY=your_key_here

# Optional: Discord webhook URL for wrong-comic reports and barcode mapping logs.
# Create a webhook in your Discord server and paste the full URL here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
